<manifest xmlns:android='http://schemas.android.com/apk/res/android'>
    <uses-permission android:name='android.permission.INTERNET'/>

    <application
        android:allowBackup='false'
        android:icon='@drawable/wytelab_icon'
        android:label='@string/app_name'
        android:roundIcon='@drawable/wytelab_icon'
        android:supportsRtl='true'
        android:theme='@style/AppTheme'>

        <activity
            android:name='.WyteLabLauncherActivity'
            android:exported='true'
            android:launchMode='singleTask'>
            <meta-data
                android:name='android.support.customtabs.trusted.DEFAULT_URL'
                android:value='https://wyte.name.ng/'/>
            <meta-data
                android:name='android.support.customtabs.trusted.STATUS_BAR_COLOR'
                android:resource='@color/splash_bg'/>
            <meta-data
                android:name='android.support.customtabs.trusted.NAVIGATION_BAR_COLOR'
                android:resource='@color/splash_bg'/>
            <meta-data
                android:name='android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK'
                android:resource='@color/splash_bg'/>
            <meta-data
                android:name='android.support.customtabs.trusted.DISPLAY_MODE'
                android:value='immersive'/>
            <meta-data
                android:name='android.support.customtabs.trusted.SCREEN_ORIENTATION'
                android:value='portrait'/>
            <meta-data
                android:name='android.support.customtabs.trusted.METADATA_SHARE_TARGET'
                android:resource='@string/share_target'/>
            <intent-filter>
                <action android:name='android.intent.action.MAIN'/>
                <category android:name='android.intent.category.LAUNCHER'/>
            </intent-filter>
            <intent-filter android:autoVerify='true'>
                <action android:name='android.intent.action.VIEW'/>
                <category android:name='android.intent.category.DEFAULT'/>
                <category android:name='android.intent.category.BROWSABLE'/>
                <data android:scheme='https' android:host='wyte.name.ng'/>
            </intent-filter>
            <intent-filter>
                <action android:name='android.intent.action.SEND'/>
                <category android:name='android.intent.category.DEFAULT'/>
                <data android:mimeType='text/plain'/>
            </intent-filter>
            <intent-filter>
                <action android:name='android.intent.action.VIEW'/>
                <category android:name='android.intent.category.DEFAULT'/>
                <category android:name='android.intent.category.BROWSABLE'/>
                <data android:scheme='wytelab'/>
            </intent-filter>
        </activity>
    </application>
</manifest>
