# WyteLab server environment
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://wyte.name.ng/api/auth/github/callback
SESSION_SECRET=

# Gemini AI (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional comma-separated stable Gemini fallback chain. Leave blank to use WyteLab defaults.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
# AI diagnosis is Pro-only; Pro allows 5 diagnoses per UTC day.

# Firebase Admin (server-only; use either service-account JSON or the three fields)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client / FCM configuration. Client values are exposed to the browser for FCM registration.

# Flutterwave v4 (server-only unless noted)
FLW_ENV=live
FLW_BASE_URL=
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_WEBHOOK_SECRET_HASH=
FLW_ENCRYPTION_KEY=
FLW_PRO_USD_MONTHLY=7.99
FLW_PRO_USD_ANNUAL=79.9
# Set these to your chosen NGN equivalents; defaults preserve the existing ₦7,500 monthly price.
FLW_PRO_NGN_MONTHLY=7500
FLW_PRO_NGN_ANNUAL=79900
# Optional: Flutterwave v4 sandbox scenario simulation header. Leave blank in production.
FLW_SCENARIO_KEY=
CRON_SECRET=

# Frontend API base URL (public; defaults to /api).
VITE_API_BASE_URL=

# Google Workspace Marketplace / Drive integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://wyte.name.ng/api/auth/google/callback

# Shared Flutterwave webhook: also processes Kivora KIVORA-* campaign payments.
# Optional unless this deployment also processes Kivora campaign payments.
KIVORA_FIREBASE_SERVICE_ACCOUNT_JSON=
# Legacy Flutterwave v3 secret used only to verify Kivora campaign transactions.
# Set one of these only when Kivora webhook verification is enabled.
FLW_SECRET_KEY=
# Alternate name accepted for the same legacy v3 secret.
FLUTTERWAVE_SECRET_KEY=
# Legacy single NGN-price fallback; prefer the monthly/annual variables above.
FLW_PRO_NGN=
