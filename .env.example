# WyteLab server environment
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://wyte.name.ng/api/auth/github/callback
SESSION_SECRET=

# Gemini AI (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional comma-separated stable Gemini fallback chain. Leave blank to use WyteLab defaults.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
AI_FREE_DAILY_LIMIT=3
AI_PRO_DAILY_LIMIT=5

# Firebase Admin (server-only; use either service-account JSON or the three fields)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client / FCM configuration. Client values are exposed to the browser for FCM registration.

# Flutterwave v4 (server-only unless noted)
FLW_ENV=live
FLW_BASE_URL=
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_WEBHOOK_SECRET_HASH=
FLW_ENCRYPTION_KEY=
FLW_PRO_USD=7
FLW_PRO_NGN=7500
# Optional: Flutterwave v4 sandbox scenario simulation header. Leave blank in production.
FLW_SCENARIO_KEY=
CRON_SECRET=

# Application limits
FREE_REPO_LIMIT=10
VITE_API_BASE_URL=

# Google Workspace Marketplace / Drive integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://wyte.name.ng/api/auth/google/callback
