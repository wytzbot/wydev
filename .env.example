# WyDev server environment
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/github/callback
SESSION_SECRET=

# Gemini AI (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_FREE_DAILY_LIMIT=5
AI_PRO_DAILY_LIMIT=20

# Firebase Admin (server-only; use either service-account JSON or the three fields)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Flutterwave v4 (server-only unless noted)
FLW_ENV=live
FLW_BASE_URL=
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_WEBHOOK_SECRET_HASH=
FLW_ENCRYPTION_KEY=
FLW_PRO_USD=9.99
FLW_PRO_NGN=9000
FLW_SCENARIO_KEY=
CRON_SECRET=

# Application limits
FREE_REPO_LIMIT=10
VITE_API_BASE_URL=
