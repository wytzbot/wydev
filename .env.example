# WyDev server environment
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://wydev.vercel.app/api/auth/github/callback
SESSION_SECRET=

# Gemini AI (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional comma-separated stable Gemini fallback chain. Leave blank to use WyDev defaults.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
AI_FREE_DAILY_LIMIT=3
AI_PRO_DAILY_LIMIT=5

# Firebase Admin (server-only; use either service-account JSON or the three fields)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Public web push configuration (not service-account secrets). These values are exposed to the browser only for FCM registration.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=

# Flutterwave v4 (server-only unless noted)
FLW_ENV=live
FLW_BASE_URL=
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_WEBHOOK_SECRET_HASH=
FLW_ENCRYPTION_KEY=
FLW_PRO_USD=1
FLW_PRO_NGN=1000
# Optional: Flutterwave v4 sandbox scenario simulation header. Leave blank in production.
FLW_SCENARIO_KEY=
CRON_SECRET=

# Application limits
FREE_REPO_LIMIT=10
VITE_API_BASE_URL=
